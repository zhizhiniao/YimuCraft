    "three": "0.186.1"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.13",
    "ffmpeg-static": "5.3.0",
    "fontkit": "^2.0.4",
    "js-yaml": "4.3.2",
